{
  "name": "@sh/hardhat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "chain": "hardhat node",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy": "hardhat run scripts/deploy.ts --network hederaTestnet",
    "bootstrap": "hardhat run scripts/bootstrap.ts --network hederaTestnet",
    "associate": "hardhat run scripts/associate.ts --network hederaTestnet",
    "export-abis": "hardhat run scripts/exportAbis.ts --no-compile",
    "lint": "tsc --noEmit && prettier --check 'contracts/**/*.sol' 'scripts/**/*.ts' 'test/**/*.ts' && eslint .",
    "test:fork": "HEDERA_FORKING=true hardhat test test-fork/liquidation.fork.test.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.88.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@pythnetwork/pyth-sdk-solidity": "^4.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@hashgraph/system-contracts-forking": "0.1.2",
    "@nomicfoundation/ethereumjs-util": "^9.0.4",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "chai": "^4.5.0",
    "eslint": "^9.12.0",
    "ethereum-cryptography": "^0.1.3",
    "ethers": "^6.13.2",
    "hardhat": "^2.22.12",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.4.1",
    "solidity-coverage": "^0.8.13",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.2"
  }
}
