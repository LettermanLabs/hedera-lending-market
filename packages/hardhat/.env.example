# Hedera testnet credentials used by the deploy scripts.
# Copy the repo-root .env.example to the REPO ROOT as .env — the scripts read ../../.env.
HEDERA_ACCOUNT_ID=0.0.XXXXXX
HEDERA_PRIVATE_KEY=0x...

# Optional override (defaults to Hashio testnet relay)
HEDERA_RPC_URL=https://testnet.hashio.io/api
