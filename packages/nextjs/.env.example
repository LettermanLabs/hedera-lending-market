# Copy to .env.local for the frontend/server. npm run deploy merges public addresses
# here while retaining your unrelated settings. Never commit .env.local.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Server-only price API settings. Never use NEXT_PUBLIC_ for API keys.
HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
# Optional HCS writer: use the testnet topic submit-key account from deployment.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
# Writable persistent directory for deduplication/rate-limit journals.
ACTIVITY_STORE_DIR=.data/activity
