# Root .env: deployment/bootstrap only; the Next.js server does not load it.
HEDERA_ACCOUNT_ID=0.0.XXXXXX
# Funded testnet account ECDSA key: raw hex (with/without 0x) or DER hex.
HEDERA_PRIVATE_KEY=
# Optional testnet relay override.
HEDERA_RPC_URL=https://testnet.hashio.io/api
# Hermes signed price service. The default requires a Pyth API key.
HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
